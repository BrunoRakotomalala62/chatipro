{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/models", "dest": "/api/models.js" },
    { "src": "/api/image", "dest": "/api/image.js" },
    { "src": "/api/image/edit", "dest": "/api/image-edit.js" },
    { "src": "/api/aichatpro/models", "dest": "/api/aichatpro/models.js" },
    { "src": "/api/aichatpro/image/edit", "dest": "/api/aichatpro/image-edit.js" },
    { "src": "/api/aichatpro/image", "dest": "/api/aichatpro/image.js" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
